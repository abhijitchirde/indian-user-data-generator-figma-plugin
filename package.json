{
  "name": "Indian-User-Data-Generator",
  "version": "1.0.0",
  "description": "Generate sample data for Indian users",
  "main": "code.js",
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit -p .",
    "dev": "webpack --mode=development --watch",
    "build": "webpack --mode=production"
  },
  "jest": {
    "testEnvironment": "node",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "json"
    ],
    "roots": [
      "<rootDir>/tests"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "target": "es2020",
            "esModuleInterop": true,
            "isolatedModules": true
          }
        }
      ]
    }
  },
  "author": "Abhijit Chirde",
  "license": "MIT",
  "devDependencies": {
    "@figma/plugin-typings": "^1.82.0",
    "@types/jest": "^30.0.0",
    "css-loader": "^7.1.2",
    "html-inline-script-webpack-plugin": "^3.2.1",
    "html-webpack-plugin": "^5.6.3",
    "jest": "^30.5.2",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.5.1",
    "typescript": "^5.6.3",
    "url-loader": "^4.1.1",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@types/node": "^22.7.9",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "csstype": "^3.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
